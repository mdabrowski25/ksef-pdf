{
  "name": "@mdab25/ksef-pdf",
  "version": "1.0.0",
  "description": "Node.js PDF generator for KSeF FA(1)/FA(2)/FA(3)/FA_RR(1) invoices and UPO XML documents.",
  "type": "module",
  "license": "MIT",
  "author": "mdabrowski25",
  "homepage": "https://github.com/mdabrowski25/ksef-pdf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdabrowski25/ksef-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/mdabrowski25/ksef-pdf/issues"
  },
  "keywords": [
    "ksef",
    "invoice",
    "pdf",
    "xml",
    "poland"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "UPSTREAM.md",
    "docs",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:release": "node scripts/check-release.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "i18next": "^25.8.4",
    "pdfmake": "^0.3.11",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/pdfmake": "^0.3.2",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "jsdom": "^26.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
