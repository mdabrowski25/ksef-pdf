{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/upstream/shared/*"]
    },
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "test", "scripts", "vitest.config.ts", "tsup.config.ts"],
  "exclude": ["src/upstream/**/*.spec.ts"]
}
